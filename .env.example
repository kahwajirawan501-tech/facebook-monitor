# ============ الأهداف ============
# روابط صفحات/مجموعات/بروفايلات فيسبوك، مفصولة بفاصلة
TARGET_URLS=https://www.facebook.com/example1,https://www.facebook.com/example2

# ============ Telegram ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Turso Database ============
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ============ Gemini (OCR) ============
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# اسم الموديل قابل للتغيير بدون تعديل الكود — راجع توثيق Google بشكل دوري
GEMINI_MODEL=gemini-3.6-flash

# ============ إعدادات التشغيل ============
MAX_CONCURRENT_TASKS=3
CHECK_INTERVAL_SECONDS=120
RUN_ONCE=false

# عدد الدورات المتتالية بدون أي منشور جديد قبل إرسال تنبيه "احتمال تغيّر بنية فيسبوك"
EMPTY_CYCLES_ALERT_THRESHOLD=5

# ============ مسارات ============
USER_DATA_DIR=user_data
DOWNLOAD_DIR=downloads
# مسار ملف الـ selectors (يمكن تعديله بدون لمس الكود)
SELECTORS_FILE=selectors.json
# حالة تسجيل الدخول لفيسبوك (JSON من storage_state لـ Playwright)
FB_AUTH_STATE_JSON=

# ============ Logging ============
LOG_LEVEL=INFO
LOG_DIR=logs
